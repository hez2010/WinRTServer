<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
    <Platforms>x86;x64;ARM64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(PlatformTarget)'=='x86'">win-x86</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(PlatformTarget)'=='x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(PlatformTarget)'=='arm64'">win-arm64</RuntimeIdentifier>
    <CsWinRTIncludes>WinRTServer</CsWinRTIncludes>
    <CsWinRTAotWarningLevel>2</CsWinRTAotWarningLevel>
    <CsWinRTWindowsMetadata>10.0.26100.0</CsWinRTWindowsMetadata>
    <WindowsSdkPackageVersion>10.0.26100.87</WindowsSdkPackageVersion>
    <EnableMsixTooling>true</EnableMsixTooling>
    <IncludePublishItemsOutputGroup>true</IncludePublishItemsOutputGroup>
    <IncludeBuiltProjectOutputGroup Condition="'$(PublishAot)' == 'true'">false</IncludeBuiltProjectOutputGroup>
    <IncludeCopyLocalFilesOutputGroup Condition="'$(PublishAot)' == 'true'">false</IncludeCopyLocalFilesOutputGroup>
    <IncludeGetCopyToOutputDirectoryItemsOutputGroup Condition="'$(PublishAot)' == 'true'">false</IncludeGetCopyToOutputDirectoryItemsOutputGroup>
    <DefaultLanguage>ja-JP</DefaultLanguage>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxHarvestWinmdRegistration>false</AppxHarvestWinmdRegistration>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" Version="1.7.260930100" PrivateAssets="all" />
    <ProjectReference Include="..\WinRTServer\WinRTServer.csproj" ReferenceOutputAssembly="false" Private="false" />
    <Content Include="Images\*.png" />
    <CsWinRTInputs Include="../WinRTServer/bin/$(Platform)/$(Configuration)/$(TargetFramework)/win-$(Platform)/WinRTServer.winmd">
      <Name>%(Filename)</Name>
      <IsWinMDFile>true</IsWinMDFile>
    </CsWinRTInputs>
    <None Include="../WinRTServer/bin/$(Platform)/$(Configuration)/$(TargetFramework)/win-$(Platform)/WinRTServer.winmd">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(Filename).winmd</Link>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

  <Target Name="IncludeWinRTServerInPackage" BeforeTargets="_ComputeAppxPackagePayload" DependsOnTargets="ResolveProjectReferences">
    <MSBuild Projects="@(ProjectReference)"
             Targets="GetWinRTServerPackageFiles"
             Properties="Configuration=$(Configuration);Platform=$(Platform);RuntimeIdentifier=$(RuntimeIdentifier);PublishAot=$(PublishAot)">
      <Output TaskParameter="TargetOutputs" ItemName="_WinRTServerPublishItems" />
    </MSBuild>
    <ItemGroup>
      <AppxPackagePayload Include="@(_WinRTServerPublishItems)">
        <TargetPath>WinRTServer\%(_WinRTServerPublishItems.TargetPath)</TargetPath>
        <OutputGroup>PublishItemsOutputGroupOutput</OutputGroup>
      </AppxPackagePayload>
    </ItemGroup>
  </Target>
</Project>
