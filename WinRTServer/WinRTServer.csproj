<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Change the OutputType to 'Library' if you want to use in-process WinRT server -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <CsWinRTComponent>true</CsWinRTComponent>
    <CsWinRTAotWarningLevel>2</CsWinRTAotWarningLevel>
    <SelfContained Condition="'$(OutputType)'=='Library' and '$(PublishAot)'!='true'">false</SelfContained>
    <SelfContained Condition="'$(OutputType)'!='Library' and '$(PublishAot)'!='true'">true</SelfContained>
    <NativeLib Condition="'$(OutputType)'=='Library' and '$(PublishAot)'=='true'">Shared</NativeLib>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(PlatformTarget)'=='x86'">win-x86</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(PlatformTarget)'=='x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(PlatformTarget)'=='arm64'">win-arm64</RuntimeIdentifier>
    <CsWinRTWindowsMetadata>10.0.26100.0</CsWinRTWindowsMetadata>
    <WindowsSdkPackageVersion>10.0.26100.87</WindowsSdkPackageVersion>
    <CsWinRTEnableLogging>true</CsWinRTEnableLogging>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1" />
    <None Include="bin/$(Platform)/$(Configuration)/$(TargetFramework)/win-$(Platform)/WinRTServer.winmd">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(Filename).winmd</Link>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

  <Target Name="GetWinRTServerPackageFiles" DependsOnTargets="ComputeFilesToPublish" Returns="@(_WinRTServerPackageFiles)">
    <ItemGroup>
      <_WinRTServerPackageFiles Include="@(ResolvedFileToPublish->'%(FullPath)')">
        <TargetPath>%(ResolvedFileToPublish.RelativePath)</TargetPath>
      </_WinRTServerPackageFiles>
    </ItemGroup>
  </Target>

</Project>
